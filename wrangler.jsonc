{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shitty-structure",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*",
      "/robots.txt",
      "/sitemap.xml",
    ],
    "not_found_handling": "single-page-application",
  },
  "placement": {
    "mode": "smart",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shitty-structure",
      "database_id": "9844a369-1bf8-4838-aed8-643e82e977c0",
    },
  ],
  "vars": {
    "PHOTO_MAX_AGE_DAYS": "14",
    "VERIFICATION_VALID_DAYS": "30",
    "TURNSTILE_SITE_KEY": "0x4AAAAAADiM-YLw88s2LYt0",
  },
  "observability": {
    "enabled": true,
  },
}
