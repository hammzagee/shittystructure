{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shitty-structure",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shitty-structure",
      "database_id": "replace-with-cloudflare-d1-database-id"
    }
  ],
  "vars": {
    "PHOTO_MAX_AGE_DAYS": "14",
    "VERIFICATION_VALID_DAYS": "30"
  },
  "observability": {
    "enabled": true
  }
}
